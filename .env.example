# 複製成 .env 再填（.env 不會進 git）。每一個都是「用到才需要」，申請方式見 docs/金鑰申請.md

# llm.provider: claude_api 時需要
ANTHROPIC_API_KEY=

# source.type: threads_api 時需要
THREADS_ACCESS_TOKEN=

# notify.line: true 時需要
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO_ID=

# notify.discord: true 時需要
DISCORD_WEBHOOK_URL=

# 審核後台要給其他裝置連（review.host 不是 127.0.0.1）時必填
RADAR_REVIEW_PASSWORD=

# 自動發文外掛（另外安裝、預設關閉）才需要
THREADS_USER_ID=
